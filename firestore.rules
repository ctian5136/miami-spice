rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public-ish profile doc: any signed-in user can look someone up by
    // name/email and see their picksCount preview before friending them.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;

      // Presence of /users/{uid}/friends/{friendUid} means friendUid is a
      // friend of uid. Either party may write their own entry on either
      // side, which is what the mutual-accept flow needs.
      match /friends/{friendUid} {
        allow read: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
        allow write: if request.auth != null && (request.auth.uid == uid || request.auth.uid == friendUid);
      }
    }

    // Want/eaten lists, notes, photo refs. Owner always has full access;
    // accepted friends get read-only access.
    match /userPicks/{userId} {
      allow read: if request.auth != null &&
        (request.auth.uid == userId ||
         exists(/databases/$(database)/documents/users/$(userId)/friends/$(request.auth.uid)));
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Friend requests, keyed as "{fromUid}_{toUid}".
    match /friendRequests/{requestId} {
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.from &&
        request.resource.data.status == 'pending';
      allow read: if request.auth != null &&
        (resource == null || request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
      allow delete: if request.auth != null &&
        (request.auth.uid == resource.data.from || request.auth.uid == resource.data.to);
    }

    // Shared, collaborative restaurant lists. Any member has equal edit
    // rights on the list itself (rename, invite/remove members) and on
    // its items/comments; only the creator can delete the whole list.
    match /lists/{listId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      // Personal lists can be renamed but never gain/lose members. Existing
      // members can change anything (rename, invite/remove others); someone
      // who isn't a member yet may only add themself (invite-link self-join
      // on a shared, non-personal list) and nothing else.
      allow update: if request.auth != null &&
        (
          (request.auth.uid in resource.data.memberIds &&
            (resource.data.isPersonal != true || request.resource.data.memberIds == resource.data.memberIds)) ||
          (resource.data.isPersonal != true &&
            !(request.auth.uid in resource.data.memberIds) &&
            request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid]) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds"]))
        );
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.memberIds &&
        request.auth.uid == request.resource.data.ownerId;
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.ownerId && resource.data.isPersonal != true;

      match /items/{itemId} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.memberIds;

        match /comments/{commentId} {
          allow read, create: if request.auth != null &&
            request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.memberIds;
          allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
        }
      }
    }
  }
}
